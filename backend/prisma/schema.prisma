generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  // Nullable — akun lama (sebelum fitur ini ada) belum tentu punya email.
  // Postgres memperlakukan banyak NULL sebagai "tidak sama satu sama lain",
  // jadi @unique tetap aman dipasang tanpa perlu isi email dummy ke akun lama.
  // Akun BARU tetap wajib isi email — itu divalidasi di kode (routes/auth.js),
  // bukan di level skema.
  email     String?   @unique
  password  String
  namaPena  String
  bio       String    @default("")
  role      String    @default("penulis")
  banned    Boolean   @default(false)
  createdAt DateTime  @default(now())

  // --- Verifikasi email ---
  // Akun baru dibuat dengan emailVerified=false; tidak bisa login sampai
  // memasukkan kode yang dikirim ke email. Akun lama (dibuat sebelum fitur
  // ini ada, mis. lewat createSuperadmin.js) dianggap sudah terverifikasi
  // secara default supaya tidak terkunci keluar dari akunnya sendiri.
  emailVerified         Boolean   @default(true)
  kodeVerifikasi        String?
  kodeVerifikasiExpiry  DateTime?

  // --- Lupa kata sandi ---
  // Sama pola-nya dengan verifikasi email: kode 6 digit dikirim ke email,
  // berlaku singkat, dan wajib cocok sebelum kata sandi baru bisa disimpan.
  kodeResetPassword       String?
  kodeResetPasswordExpiry DateTime?

  posts     Post[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  notifikasi Notification[]
  laporanDibuat Report[]

  // Mengikuti / diikuti — self-relation lewat tabel Follow di bawah.
  mengikuti   Follow[] @relation("Pengikut")
  pengikut    Follow[] @relation("Diikuti")

  koleksi     Collection[]
  reaksi      Reaction[]
  // Jejak aksi yang PERNAH dilakukan user ini selagi jadi admin (lihat
  // AdminLog di bawah). Tetap ada walau role-nya diturunkan lagi nanti —
  // adminId di-SET NULL cuma kalau akunnya benar-benar dihapus.
  logAdmin    AdminLog[]
}

model Post {
  id            String    @id @default(cuid())
  judul         String
  tipe          String    @default("cerpen")
  isi           String    @default("")
  isiHtml       String    @default("")
  status        String    @default("draft")
  catatanAdmin  String    @default("")
  // DEPRECATED — sisa dari sistem kategori lama (satu kategori per tulisan).
  // Tidak dihapus dari skema supaya data lama tidak hilang & migrasi ke
  // sistem tag (lihat field "tags" di bawah, dan scripts/migrateKategoriToTags.js)
  // bisa ditelusuri ulang kapan saja kalau perlu. Tidak dipakai lagi oleh kode
  // baru — pakai "tags" untuk kategori/genre sekarang.
  kategori      String    @default("Umum")
  gambarSampul  String?
  // Jumlah kali naskah yang sudah terbit ini dibuka pembaca. Naik tiap
  // GET /api/posts/:id dipanggil (lihat routes/posts.js) — dihitung kasar
  // per-request, bukan per-pembaca-unik, cukup untuk kebutuhan situs ini.
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Kapan naskah PERTAMA KALI berstatus "terbit" — diisi sekali saat itu
  // terjadi (lihat routes/posts.js & routes/admin.js) dan tidak berubah
  // lagi sesudahnya. Dulu tanggal terbit dibaca dari "updatedAt", tapi itu
  // salah: updatedAt ikut berubah tiap kali ada aktivitas lain di baris ini
  // (mis. viewCount bertambah tiap dibaca), jadi tanggal terbit yang
  // tampil ke pembaca keliru ikut maju ke hari ini. Null untuk naskah yang
  // belum pernah terbit (draft/diajukan/ditinjau/siap_terbit/ditolak).
  publishedAt   DateTime?

  penulis       User      @relation(fields: [penulisId], references: [id], onDelete: Cascade)
  penulisId     String

  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  laporan       Report[]
  // Reaksi ekspresif (terharu/terinspirasi/dst) di halaman baca — terpisah
  // dari "likes" di atas, lihat catatan lengkap di model Reaction.
  reaksi        Reaction[]

  // Tag/kategori multi-pilih — pengganti field "kategori" tunggal di atas.
  // Relasi banyak-ke-banyak implisit lewat tabel Genre (dipakai ulang
  // sebagai kumpulan tag, bukan model baru, supaya daftar pilihan tag yang
  // sudah ada di dropdown lama otomatis jadi daftar saran tag juga).
  tags          Genre[]   @relation("PostTags")
}

model Comment {
  id        String   @id @default(cuid())
  isi       String
  namaTamu  String?
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  // Balasan komentar (threaded) — komentar tanpa parentId adalah komentar
  // utama, yang punya parentId adalah balasan terhadap komentar itu.
  // Cuma satu tingkat kedalaman yang dipakai di UI (balasan tidak dibalas
  // lagi), tapi skemanya sendiri mendukung kedalaman berapa pun.
  parent    Comment? @relation("BalasanKomentar", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  balasan   Comment[] @relation("BalasanKomentar")

  laporan   Report[]
}

model Like {
  id        String   @id @default(cuid())
  // Ditambah belakangan (khusus dipakai grafik aktivitas harian di dasbor
  // statistik penulis) — baris LAMA yang sudah ada saat migrasi dijalankan
  // otomatis terisi "sekarang" oleh Postgres, jadi tanggalnya tidak 100%
  // akurat untuk suka-suka lawas, tapi cukup untuk tren ke depannya.
  createdAt DateTime @default(now())

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([postId, userId])
}

// Daftar genre siap-pakai untuk dropdown di editor naskah (WriteEditorPage).
// Dulu field "genre" (kolom kategori di Post) diketik bebas — sekarang
// pengguna cuma memilih dari tabel ini, jadi datanya konsisten. Tambah/
// kurangi genre lewat tabel ini (Prisma Studio atau query manual), tanpa
// perlu ubah kode.
model Genre {
  id        String   @id @default(cuid())
  nama      String   @unique
  createdAt DateTime @default(now())

  // Sisi lain relasi many-to-many "tags" di atas — satu tag/genre bisa
  // dipakai di banyak tulisan sekaligus (ini yang bikin sistemnya jadi
  // "tag multi-pilih", bukan lagi satu kategori tetap per tulisan).
  posts     Post[]   @relation("PostTags")
}

// Tulisan yang "disimpan untuk dibaca nanti" oleh pembaca — terpisah dari
// Like (like = apresiasi publik & ditampilkan ke semua orang, bookmark =
// daftar bacaan pribadi, cuma pemiliknya yang lihat).
model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  // Opsional — kalau diisi, bookmark ini masuk ke salah satu "rak" koleksi
  // pribadi pemiliknya (lihat model Collection). Null = belum dikelompokkan
  // ("Tanpa Koleksi" di UI). Koleksi dihapus -> bookmark TIDAK ikut hilang,
  // cuma balik jadi tanpa-koleksi (onDelete: SetNull).
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  collectionId String?

  @@unique([postId, userId])
}

// Koleksi/rak bacaan pribadi untuk mengelompokkan bookmark (mis. "Bacaan
// Santai", "Riset Naskah") — supaya rak "Tersimpan" tidak jadi satu
// tumpukan panjang tak terorganisir kalau isinya sudah banyak.
model Collection {
  id        String     @id @default(cuid())
  nama      String
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  bookmarks Bookmark[]

  // Satu pengguna tidak boleh punya dua koleksi dengan nama sama persis.
  @@unique([userId, nama])
}

// Reaksi ekspresif di halaman baca (terharu, terinspirasi, dst) — sengaja
// dibuat sebagai model TERPISAH dari Like ("suka" di kartu tulisan),
// supaya perilaku "suka" yang sudah ada di CardPost dkk tidak ikut
// berubah. Satu pengguna cuma boleh pilih SATU jenis reaksi per naskah;
// ganti pilihan berarti upsert baris yang sama, bukan menambah baris baru.
model Reaction {
  id        String   @id @default(cuid())
  tipe      String   // 'terharu' | 'terinspirasi' | 'lucu' | 'mikir'
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([postId, userId])
}

// Mengikuti penulis lain. followerId = yang menekan tombol "Ikuti",
// followingId = penulis yang diikuti. Dipakai untuk menampilkan jumlah
// pengikut di profil publik, dan untuk mengirim notifikasi saat penulis
// yang diikuti menerbitkan naskah baru.
model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  follower    User   @relation("Pengikut", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String

  following   User   @relation("Diikuti", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  @@unique([followerId, followingId])
}

// Notifikasi dalam-aplikasi (bukan email) — dicek lewat bel di navbar.
// "tipe" dipakai frontend untuk pilih ikon/gaya, "link" untuk arah klik.
model Notification {
  id        String   @id @default(cuid())
  tipe      String   // 'komentar' | 'naskah_disetujui' | 'naskah_ditolak' | 'penulis_baru_terbit'
  pesan     String
  link      String?
  dibaca    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// Laporan konten tidak pantas — dari pembaca ke admin. Tepat satu dari
// postId/commentId terisi (bukan pakai constraint DB supaya tetap
// sederhana, divalidasi di kode — lihat POST /:id/laporkan dan
// POST /comments/:id/laporkan di routes/posts.js).
model Report {
  id        String   @id @default(cuid())
  alasan    String
  detail    String   @default("")
  status    String   @default("baru") // 'baru' | 'selesai'
  createdAt DateTime @default(now())

  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?

  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?

  pelapor   User?    @relation(fields: [pelaporId], references: [id], onDelete: SetNull)
  pelaporId String?
}

// Jejak audit aksi admin (moderasi naskah, kelola pengguna, dsb) — supaya
// ada riwayat "siapa melakukan apa, kapan" yang bisa ditelusuri kalau ada
// sengketa atau kesalahan proses. Append-only: baris di sini tidak pernah
// diedit/dihapus oleh aksi lain manapun.
model AdminLog {
  id        String   @id @default(cuid())
  aksi      String   // mis. 'naskah_disetujui', 'naskah_ditolak', 'user_diblokir', dst.
  target    String   // deskripsi singkat targetnya (judul naskah / username)
  detail    String   @default("")
  createdAt DateTime @default(now())

  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminId   String?
}

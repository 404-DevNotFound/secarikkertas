generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  nama      String
  username  String    @unique
  // Nullable — akun lama (sebelum fitur ini ada) belum tentu punya email.
  // Postgres memperlakukan banyak NULL sebagai "tidak sama satu sama lain",
  // jadi @unique tetap aman dipasang tanpa perlu isi email dummy ke akun lama.
  // Akun BARU tetap wajib isi email — itu divalidasi di kode (routes/auth.js),
  // bukan di level skema.
  email     String?   @unique
  password  String
  namaPena  String
  bio       String    @default("")
  role      String    @default("penulis")
  banned    Boolean   @default(false)
  createdAt DateTime  @default(now())

  posts     Post[]
  comments  Comment[]
  likes     Like[]
}

model Post {
  id            String    @id @default(cuid())
  judul         String
  tipe          String    @default("cerpen")
  isi           String    @default("")
  isiHtml       String    @default("")
  status        String    @default("draft")
  catatanAdmin  String    @default("")
  kategori      String    @default("Umum")
  gambarSampul  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  penulis       User      @relation(fields: [penulisId], references: [id], onDelete: Cascade)
  penulisId     String

  comments      Comment[]
  likes         Like[]
}

model Comment {
  id        String   @id @default(cuid())
  isi       String
  namaTamu  String?
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
}

model Like {
  id     String @id @default(cuid())

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([postId, userId])
}

// Daftar genre siap-pakai untuk dropdown di editor naskah (WriteEditorPage).
// Dulu field "genre" (kolom kategori di Post) diketik bebas — sekarang
// pengguna cuma memilih dari tabel ini, jadi datanya konsisten. Tambah/
// kurangi genre lewat tabel ini (Prisma Studio atau query manual), tanpa
// perlu ubah kode.
model Genre {
  id        String   @id @default(cuid())
  nama      String   @unique
  createdAt DateTime @default(now())
}
